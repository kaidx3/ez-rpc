{
    "name": "ezrpc-monorepo",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build -w @ez-rpc/core -w @ez-rpc/concurrency && npm run build -w @ez-rpc/router -w @ez-rpc/client -w @ez-rpc/mssql && npm run build -w ez-rpc",
        "dev": "npm run dev --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/mssql": "^12.3.0",
        "@types/node": "^22.0.0",
        "express": "^5.0.0",
        "mssql": "^11.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "zod": "^3.24.0"
    }
}
