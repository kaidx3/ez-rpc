{
    "name": "ez-rpc",
    "version": "0.1.0",
    "description": "Type-safe contract-first RPC layer for Express + Next.js. Define Zod schemas once, get validated server routes and typed fetch clients for free.",
    "author": "Kaiden Flaig",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        },
        "./server": {
            "import": "./dist/server.js",
            "require": "./dist/server.cjs",
            "types": "./dist/server.d.ts"
        },
        "./client": {
            "import": "./dist/client.js",
            "require": "./dist/client.cjs",
            "types": "./dist/client.d.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ez-rpc/client": "*",
        "@ez-rpc/concurrency": "*",
        "@ez-rpc/core": "*",
        "@ez-rpc/mssql": "*",
        "@ez-rpc/router": "*"
    },
    "keywords": [
        "typescript",
        "express",
        "nextjs",
        "rpc",
        "api",
        "zod",
        "type-safe",
        "contract-first",
        "monorepo",
        "schema-validation",
        "mssql",
        "fetch",
        "node"
    ],
    "peerDependencies": {
        "zod": ">=3.0.0"
    },
    "peerDependenciesMeta": {
        "express": {
            "optional": true
        },
        "mssql": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "express": "^5.0.0",
        "mssql": "^11.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "zod": "^3.24.0"
    },
    "keywords": [
        "rpc",
        "trpc",
        "type-safe",
        "zod",
        "express",
        "next.js",
        "contract-first",
        "api",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/YOUR_ORG/ezrpc"
    },
    "publishConfig": {
        "access": "public"
    }
}
