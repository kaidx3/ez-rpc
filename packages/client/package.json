{
    "name": "@ez-rpc/client",
    "version": "0.1.0",
    "description": "Typed fetch client for ezRPC. HMAC-signed requests, in-flight dedup, retry/backoff, and NDJSON streaming.",
    "author": "Kaiden Flaig",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ez-rpc/core": "*"
    },
    "keywords": [
        "typescript",
        "fetch",
        "api-client",
        "rpc",
        "zod",
        "hmac",
        "retry",
        "streaming",
        "ndjson",
        "type-safe",
        "nextjs"
    ],
    "peerDependencies": {
        "zod": ">=3.0.0"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "zod": "^3.24.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bunch-Projects/ezRPC.git",
        "directory": "packages/client"
    },
    "publishConfig": {
        "access": "public"
    }
}
