{
    "name": "@ez-rpc/core",
    "version": "0.1.0",
    "description": "Shared types and error primitives for ezRPC. Zero runtime dependencies.",
    "author": "Kaiden Flaig",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "typescript",
        "zod",
        "rpc",
        "api",
        "types",
        "contract",
        "schema-validation",
        "type-safe",
        "express",
        "nextjs"
    ],
    "peerDependencies": {
        "zod": ">=3.0.0"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "zod": "^3.24.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bunch-Projects/ezRPC.git",
        "directory": "packages/core"
    },
    "publishConfig": {
        "access": "public"
    }
}
